{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information and settings",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "currency": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Business": {
      "title": "Business",
      "description": "A business entity managed by the user",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "userId": { "type": "string" },
        "balance": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Transaction": {
      "title": "Personal Transaction",
      "description": "A personal financial transaction",
      "type": "object",
      "properties": {
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "note": { "type": "string" },
        "type": { "type": "string", "enum": ["income", "expense"] },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "BusinessTransaction": {
      "title": "Business Transaction",
      "description": "A financial transaction belonging to a business",
      "type": "object",
      "properties": {
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "note": { "type": "string" },
        "type": { "type": "string" },
        "businessId": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Sale": {
      "title": "Business Sale",
      "description": "A record of a product sale",
      "type": "object",
      "properties": {
        "productName": { "type": "string" },
        "quantity": { "type": "number" },
        "price": { "type": "number" },
        "totalPrice": { "type": "number" },
        "date": { "type": "string", "format": "date" },
        "businessId": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Product": {
      "title": "Business Product",
      "description": "An item for sale by a business",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "price": { "type": "number" },
        "stock": { "type": "number" },
        "businessId": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "BusinessDebt": {
      "title": "Business Debt",
      "description": "Money owed to or by a business",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "amount": { "type": "number" },
        "dueDate": { "type": "string", "format": "date" },
        "note": { "type": "string" },
        "status": { "type": "string", "enum": ["paid", "unpaid"] },
        "businessId": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "UpcomingPayment": {
      "title": "Upcoming Payment",
      "description": "A scheduled future payment",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "dueDate": { "type": "string", "format": "date" },
        "category": { "type": "string" },
        "status": { "type": "string" },
        "userId": { "type": "string" },
        "businessId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "BusinessIdea": {
      "title": "Business Idea",
      "description": "A potential business concept",
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "category": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "SavingsGoal": {
      "title": "Savings Goal",
      "description": "A personal financial target",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "targetAmount": { "type": "number" },
        "currentAmount": { "type": "number" },
        "deadline": { "type": "string", "format": "date" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "FinancialPlan": {
      "title": "Financial Plan",
      "description": "A recorded financial strategy or plan",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "type": { "type": "string" },
        "details": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "TrashItem": {
      "title": "Trash Item",
      "description": "A deleted record moved to trash",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "collectionName": { "type": "string" },
        "originalId": { "type": "string" },
        "data": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": "User", "description": "User profiles" },
    "/businesses/{businessId}": { "schema": "Business", "description": "Business entities" },
    "/transactions/{transactionId}": { "schema": "Transaction", "description": "Personal transactions" },
    "/businessTransactions/{txId}": { "schema": "BusinessTransaction", "description": "Business transactions" },
    "/sales/{saleId}": { "schema": "Sale", "description": "Business sales" },
    "/products/{productId}": { "schema": "Product", "description": "Business products" },
    "/businessDebts/{debtId}": { "schema": "BusinessDebt", "description": "Business debts" },
    "/upcomingPayments/{paymentId}": { "schema": "UpcomingPayment", "description": "Scheduled payments" },
    "/businessIdeas/{ideaId}": { "schema": "BusinessIdea", "description": "Business ideas" },
    "/savingsGoals/{goalId}": { "schema": "SavingsGoal", "description": "Savings targets" },
    "/financialPlans/{planId}": { "schema": "FinancialPlan", "description": "Financial plans" },
    "/trash/{trashId}": { "schema": "TrashItem", "description": "Deleted items" }
  }
}
