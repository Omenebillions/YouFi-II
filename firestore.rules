rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function ownsBusiness(businessId) {
      return get(/databases/$(database)/documents/businesses/$(businessId)).data.userId == request.auth.uid;
    }

    // --- Users ---
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && 
        incoming().keys().hasAll(['createdAt']) &&
        incoming().createdAt == request.time;
      allow update: if isOwner(userId) && 
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'currency']);
    }

    // --- Businesses ---
    match /businesses/{businessId} {
      function isValidBusiness(data) {
        return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
               data.userId == request.auth.uid &&
               data.balance is number;
      }
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isOwner(resource.data.userId);
      allow create: if isSignedIn() && isValidBusiness(incoming()) && incoming().createdAt == request.time;
      allow update: if isOwner(existing().userId) && (
        // Action: Update details
        (incoming().diff(existing()).affectedKeys().hasOnly(['name', 'category', 'description'])) ||
        // Action: Update balance (via transaction)
        (incoming().diff(existing()).affectedKeys().hasOnly(['balance']))
      );
      allow delete: if isOwner(existing().userId);
    }

    // --- Transactions (Personal) ---
    match /transactions/{txId} {
      function isValidTransaction(data) {
        return data.amount is number && data.userId == request.auth.uid &&
               data.type in ['income', 'expense'] &&
               data.date is string && data.date.size() <= 10;
      }
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isOwner(resource.data.userId);
      allow create: if isSignedIn() && isValidTransaction(incoming()) && incoming().createdAt == request.time;
      allow update: if isOwner(existing().userId) && isValidTransaction(incoming());
      allow delete: if isOwner(existing().userId);
    }

    // --- Business Transactions ---
    match /businessTransactions/{txId} {
      function isValidBT(data) {
        return data.amount is number && data.userId == request.auth.uid &&
               data.businessId is string && ownsBusiness(data.businessId) &&
               data.date is string && data.date.size() <= 10;
      }
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isOwner(resource.data.userId);
      allow create: if isSignedIn() && isValidBT(incoming()) && incoming().createdAt == request.time;
      allow update: if isOwner(existing().userId) && isValidBT(incoming()) && incoming().businessId == existing().businessId;
      allow delete: if isOwner(existing().userId);
    }

    // --- Sales ---
    match /sales/{saleId} {
      function isValidSale(data) {
        return data.totalPrice is number && data.userId == request.auth.uid &&
               data.businessId is string && ownsBusiness(data.businessId);
      }
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isOwner(resource.data.userId);
      allow create: if isSignedIn() && isValidSale(incoming()) && incoming().createdAt == request.time;
      allow update: if isOwner(existing().userId) && isValidSale(incoming());
      allow delete: if isOwner(existing().userId);
    }

    // --- Products ---
    match /products/{productId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isOwner(resource.data.userId);
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && ownsBusiness(incoming().businessId) && incoming().createdAt == request.time;
      allow update: if isOwner(existing().userId) && incoming().userId == request.auth.uid;
      allow delete: if isOwner(existing().userId);
    }

    // --- Business Debts ---
    match /businessDebts/{debtId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isOwner(resource.data.userId);
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && ownsBusiness(incoming().businessId) && incoming().createdAt == request.time;
      allow update: if isOwner(existing().userId) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'name', 'amount', 'dueDate', 'note'])
      );
      allow delete: if isOwner(existing().userId);
    }

    // --- Upcoming Payments ---
    match /upcomingPayments/{paymentId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isOwner(resource.data.userId);
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && incoming().createdAt == request.time;
      allow update: if isOwner(existing().userId);
      allow delete: if isOwner(existing().userId);
    }

    // --- Business Ideas ---
    match /businessIdeas/{ideaId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isOwner(resource.data.userId);
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && incoming().createdAt == request.time;
      allow update: if isOwner(existing().userId);
      allow delete: if isOwner(existing().userId);
    }

    // --- Savings Goals ---
    match /savingsGoals/{goalId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isOwner(resource.data.userId);
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && incoming().createdAt == request.time;
      allow update: if isOwner(existing().userId);
      allow delete: if isOwner(existing().userId);
    }

    // --- Financial Plans ---
    match /financialPlans/{planId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isOwner(resource.data.userId);
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && incoming().createdAt == request.time;
      allow update: if isOwner(existing().userId);
      allow delete: if isOwner(existing().userId);
    }

    // --- Trash ---
    match /trash/{trashId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isOwner(resource.data.userId);
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && incoming().createdAt == request.time;
      allow delete: if isOwner(existing().userId);
    }
  }
}
